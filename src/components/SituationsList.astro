---
/**
 * Liste de situations, lue dans la collection de contenu.
 *   theme : ne garder qu'un thème (nom du dossier dans situations/)
 *   limit : nombre maximal d'entrées
 *   sort  : 'title' (défaut) ou 'recent' (date de publication décroissante)
 * Les pages d'index (catalogue, thèmes, « comment lire ») ne sont jamais listées :
 * une situation a toujours un identifiant en trois parties, situations/<theme>/<slug>.
 * Dans la version anglaise, la liste pointe vers /en/… et prend le titre de la
 * traduction quand elle existe ; sinon celui de la page française, marquée
 * « in French » (voir src/i18n.ts).
 */
import { getCollection } from 'astro:content';
import { byShownTitle, currentLocale, metaLine, pageHref, withTranslation } from '../i18n';

interface Props {
  theme?: string;
  limit?: number;
  sort?: 'title' | 'recent';
}

const { theme, limit, sort = 'title' } = Astro.props;
const locale = currentLocale(Astro);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const all = await getCollection('docs');
const french = all.filter(({ id }) => {
  const parts = id.split('/');
  return parts[0] === 'situations' && parts.length === 3 && (!theme || parts[1] === theme);
});

const byTitle = byShownTitle(locale);
let situations = withTranslation(french, all, locale);
situations.sort(
  sort === 'recent'
    ? (a, b) => (b.fr.data.published?.getTime() ?? 0) - (a.fr.data.published?.getTime() ?? 0) || byTitle(a, b)
    : byTitle,
);
if (limit) situations = situations.slice(0, limit);
---

<ul class="home-list">
  {
    situations.map((item) => (
      <li data-level={item.fr.data.level ?? ''}>
        <a href={pageHref(base, item.fr.id, locale)} lang={item.translated ? undefined : 'fr'}>
          {item.shown.data.title}
        </a>
        <p lang={item.translated ? undefined : 'fr'}>{item.shown.data.description}</p>
        {metaLine(item, locale) && <small>{metaLine(item, locale)}</small>}
      </li>
    ))
  }
</ul>
