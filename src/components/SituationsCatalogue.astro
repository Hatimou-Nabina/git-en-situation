---
/**
 * Le catalogue complet : toutes les situations, groupées par thème, avec un
 * filtre par niveau qui agit sans rechargement. Conçu pour rester lisible à
 * une centaine de pages : les thèmes découpent, le filtre resserre, et la
 * recherche (Ctrl+K) reste le chemin le plus court quand on sait ce qu'on cherche.
 * Dans la version anglaise, les libellés sont en anglais et les pages encore en
 * français sont marquées « in French » (voir src/i18n.ts).
 */
import { getCollection } from 'astro:content';
import { themes } from '../themes.mjs';
import {
  byShownTitle,
  capitalize,
  currentLocale,
  levelLabels,
  metaLine,
  pageHref,
  strings,
  themeDescription,
  themeLabel,
  withTranslation,
} from '../i18n';

const locale = currentLocale(Astro);
const t = strings[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const levels = levelLabels[locale];

const everything = await getCollection('docs');
const french = everything.filter(({ id }) => {
  const parts = id.split('/');
  return parts[0] === 'situations' && parts.length === 3;
});
const all = withTranslation(french, everything, locale);
const byTitle = byShownTitle(locale);

const sections = Object.keys(themes).map((key) => ({
  key,
  label: themeLabel(key, locale),
  description: themeDescription(key, locale),
  items: all.filter(({ fr }) => fr.id.startsWith(`situations/${key}/`)).sort(byTitle),
}));

const countByLevel = Object.fromEntries(
  Object.keys(levels).map((level) => [level, all.filter(({ fr }) => fr.data.level === level).length]),
);
---

<div class="catalogue" data-catalogue>
  <p class="catalogue__summary">{t.catalogueSummary(all.length, sections.length)}</p>

  <div class="catalogue__filters" role="group" aria-label={t.filterByLevel}>
    <button type="button" data-level="" aria-pressed="true">{t.allLevels}</button>
    {
      Object.entries(levels).map(([key, label]) => (
        <button type="button" data-level={key} aria-pressed="false">
          {capitalize(label)} <span class="catalogue__count">{countByLevel[key]}</span>
        </button>
      ))
    }
  </div>

  {
    sections.map((section) => (
      <section class="catalogue__theme" data-theme={section.key}>
        <h2 id={section.key}>
          <a href={pageHref(base, `situations/${section.key}`, locale)}>{section.label}</a>
          <span class="catalogue__count">{section.items.length}</span>
        </h2>
        <p class="catalogue__description">{section.description}</p>
        <ul class="home-list">
          {section.items.map((item) => (
            <li data-level={item.fr.data.level ?? ''}>
              <a href={pageHref(base, item.fr.id, locale)} lang={item.translated ? undefined : 'fr'}>
                {item.shown.data.title}
              </a>
              <p lang={item.translated ? undefined : 'fr'}>{item.shown.data.description}</p>
              {metaLine(item, locale) && <small>{metaLine(item, locale)}</small>}
            </li>
          ))}
        </ul>
        <p class="catalogue__empty" hidden>{t.emptyTheme}</p>
      </section>
    ))
  }
</div>

<script>
  // Filtre par niveau : on masque les entrées qui ne correspondent pas, et le
  // message « aucune » apparaît dans les thèmes vidés. Sans JavaScript, tout
  // est affiché, ce qui reste un catalogue complet.
  for (const root of document.querySelectorAll<HTMLElement>('[data-catalogue]')) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.catalogue__filters button');
    const apply = (level: string) => {
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.level === level));
      for (const theme of root.querySelectorAll<HTMLElement>('.catalogue__theme')) {
        let visible = 0;
        for (const item of theme.querySelectorAll<HTMLElement>('li[data-level]')) {
          const shown = !level || item.dataset.level === level;
          item.hidden = !shown;
          if (shown) visible++;
        }
        const empty = theme.querySelector<HTMLElement>('.catalogue__empty');
        if (empty) empty.hidden = visible > 0;
      }
    };
    for (const button of buttons) button.addEventListener('click', () => apply(button.dataset.level ?? ''));
  }
</script>
