---
/**
 * « Où ça sert » d'une fiche de commande : les pages du site où la commande
 * est réellement exécutée, c'est-à-dire celles dont une ligne de terminal
 * commence par « $ git <commande> ». La liste est calculée au build depuis le
 * contenu : elle ne se périme pas.
 *   command : le nom de la sous-commande (« log », « branch »…)
 *   prefix  : ce qui précède la sous-commande, « git » par défaut, « » pour
 *             un outil à part entière comme gh
 *   mode    : « executed » (défaut), les pages qui exécutent la commande ;
 *             « cited », les pages qui la citent dans le texte, entre
 *             accents graves. Pour les commandes qu'aucun script ne peut
 *             exécuter (gh demande un compte connecté).
 * Les pages françaises font référence (les blocs de terminal sont les mêmes
 * dans les deux langues) ; la version anglaise affiche le titre de la
 * traduction quand elle existe et pointe vers /en/… (voir src/i18n.ts).
 * Les fiches elles-mêmes et les pages d'index sont exclues.
 */
import { getCollection } from 'astro:content';
import { byShownTitle, currentLocale, pageHref, strings, themeLabel, withTranslation } from '../i18n';

interface Props {
  command: string;
  prefix?: string;
  mode?: 'executed' | 'cited';
}

const { command, prefix = 'git', mode = 'executed' } = Astro.props;
const locale = currentLocale(Astro);
const t = strings[locale];
const english = locale === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const escape = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const full = prefix ? `${prefix} ${command}` : command;
const pattern =
  mode === 'cited'
    ? new RegExp('`' + escape(full) + '( [^`]*)?`')
    : new RegExp(`^\\$ ${escape(full)}(\\s|$)`, 'm');

const everything = await getCollection('docs');
const french = everything.filter(({ id, body }) => {
  const parts = id.split('/');
  const isSituation = parts[0] === 'situations' && parts.length === 3;
  const isPage = (parts[0] === 'comprendre' || parts[0] === 'equipe') && parts.length === 2;
  return (isSituation || isPage) && pattern.test(body ?? '');
});
const all = withTranslation(french, everything, locale).sort(byShownTitle(locale));

const sections = [
  { label: t.sections.situations, entries: all.filter(({ fr }) => fr.id.startsWith('situations/')) },
  { label: t.sections.comprendre, entries: all.filter(({ fr }) => fr.id.startsWith('comprendre/')) },
  { label: t.sections.equipe, entries: all.filter(({ fr }) => fr.id.startsWith('equipe/')) },
].filter((s) => s.entries.length > 0);

// [singulier, pluriel]
const verb = english
  ? mode === 'cited' ? ['cites', 'cite'] : ['runs', 'run']
  : mode === 'cited' ? ['cite', 'citent'] : ['exécute', 'exécutent'];
const count =
  all.length === 1
    ? english ? `One page of this site ${verb[0]}` : `Une page de ce site ${verb[0]}`
    : english ? `${all.length} pages of this site ${verb[1]}` : `${all.length} pages de ce site ${verb[1]}`;
---

<div class="command-usages">
  {
    all.length === 0 ? (
      <p>
        {english ? (
          <>No page of this site {verb[0]} <code>{full}</code> yet.</>
        ) : (
          <>Aucune page de ce site n'{verb[0]} encore <code>{full}</code>.</>
        )}
      </p>
    ) : (
      <>
        <p>
          {count} <code>{full}</code>{english ? ':' : ' :'}
        </p>
        {sections.map(({ label, entries }) => (
          <>
            <p class="command-usages__section">{label}</p>
            <ul>
              {entries.map(({ fr, shown, translated }) => (
                <li>
                  <a href={pageHref(base, fr.id, locale)} lang={translated ? undefined : 'fr'}>
                    {shown.data.title}
                  </a>
                  {fr.id.startsWith('situations/') && <small> · {themeLabel(fr.id.split('/')[1], locale)}</small>}
                  {!translated && <small> · {t.inFrench}</small>}
                </li>
              ))}
            </ul>
          </>
        ))}
      </>
    )
  }
</div>

<style>
  .command-usages__section {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .command-usages ul {
    margin-top: 0;
  }
  .command-usages small {
    color: var(--sl-color-gray-3);
  }
</style>
